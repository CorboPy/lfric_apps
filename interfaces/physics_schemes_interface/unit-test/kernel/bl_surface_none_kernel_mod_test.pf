!-----------------------------------------------------------------------------
!> Test the kernel setting the BL lower boundary with no surface scheme
!>
module bl_surface_none_kernel_mod_test

  use funit
  use constants_mod, only : r_def, i_def

  implicit none

  private
  public :: test_bl_surface_none

  integer(i_def), parameter :: nlayers   = 3_i_def
  integer(i_def), parameter :: ndf_w3    = 1_i_def
  integer(i_def), parameter :: undf_w3   = nlayers
  integer(i_def), parameter :: ndf_wth   = 2_i_def
  integer(i_def), parameter :: undf_wth  = nlayers + 1_i_def
  integer(i_def), parameter :: ndf_surf  = 11_i_def
  integer(i_def), parameter :: undf_surf = ndf_surf
  integer(i_def), parameter :: ndf_2d    = 1_i_def
  integer(i_def), parameter :: undf_2d   = 1_i_def

  ! Value used to check that only the expected entries are written
  real(r_def), parameter :: unset = -999.0_r_def

contains

  @test
  subroutine test_bl_surface_none()

    use bl_surface_none_kernel_mod, only : bl_surface_none_code

    implicit none

    real(r_def), parameter :: tol = 1.0e-14_r_def
    real(r_def), parameter :: wetrho_surf = 1.2_r_def

    integer(i_def) :: map_w3(ndf_w3), map_wth(ndf_wth), map_surf(ndf_surf), &
                      map_2d(ndf_2d)
    integer(i_def) :: df

    real(r_def)    :: wetrho_in_w3(undf_w3)
    real(r_def)    :: rhokm_bl(undf_wth), gradrinr(undf_wth)
    real(r_def)    :: rhokh_bl(undf_w3), moist_flux_bl(undf_w3), &
                      heat_flux_bl(undf_w3)
    real(r_def)    :: surf_interp(undf_surf)
    integer(i_def) :: blend_height_tq(undf_2d)
    real(r_def)    :: z0m_eff(undf_2d), ustar(undf_2d), rhostar(undf_2d), &
                      recip_l_mo_sea(undf_2d), t1_sd(undf_2d), q1_sd(undf_2d)

    real(r_def)    :: surf_interp_ans(undf_surf)

    map_w3(1) = 1_i_def
    map_wth = (/ 1_i_def, 2_i_def /)
    map_surf = (/ (df, df = 1, ndf_surf) /)
    map_2d(1) = 1_i_def

    wetrho_in_w3 = (/ wetrho_surf, 1.1_r_def, 1.0_r_def /)

    rhokm_bl        = unset
    gradrinr        = unset
    rhokh_bl        = unset
    moist_flux_bl   = unset
    heat_flux_bl    = unset
    surf_interp     = unset
    blend_height_tq = -1_i_def
    z0m_eff         = unset
    ustar           = unset
    rhostar         = unset
    recip_l_mo_sea  = unset
    t1_sd           = unset
    q1_sd           = unset

    call bl_surface_none_code( nlayers,                          &
                               wetrho_in_w3,                     &
                               rhokm_bl, rhokh_bl,               &
                               moist_flux_bl, heat_flux_bl,      &
                               gradrinr, surf_interp,            &
                               blend_height_tq, z0m_eff, ustar,  &
                               rhostar, recip_l_mo_sea,          &
                               t1_sd, q1_sd,                     &
                               ndf_w3, undf_w3, map_w3,          &
                               ndf_wth, undf_wth, map_wth,       &
                               ndf_surf, undf_surf, map_surf,    &
                               ndf_2d, undf_2d, map_2d )

    ! Surface values are free slip and zero flux
    @assertEqual( 0.0_r_def, rhokm_bl(1), tol )
    @assertEqual( 0.0_r_def, rhokh_bl(1), tol )
    @assertEqual( 0.0_r_def, moist_flux_bl(1), tol )
    @assertEqual( 0.0_r_def, heat_flux_bl(1), tol )
    @assertEqual( 0.0_r_def, gradrinr(1), tol )

    ! Levels above the surface are not touched
    @assertEqual( unset, rhokm_bl(2:undf_wth), tol )
    @assertEqual( unset, gradrinr(2:undf_wth), tol )
    @assertEqual( unset, rhokh_bl(2:undf_w3), tol )
    @assertEqual( unset, moist_flux_bl(2:undf_w3), tol )
    @assertEqual( unset, heat_flux_bl(2:undf_w3), tol )

    ! Surface variables for regridding; slot 5 (zhnl) is not touched
    surf_interp_ans = 0.0_r_def
    surf_interp_ans(1+3) = 1.0_r_def
    surf_interp_ans(1+4) = 1.0_r_def
    surf_interp_ans(1+5) = unset
    @assertEqual( surf_interp_ans, surf_interp, tol )

    ! 2D fields
    @assertEqual( 1_i_def, blend_height_tq(1) )
    @assertEqual( 0.0_r_def, z0m_eff(1), tol )
    @assertEqual( 0.0_r_def, ustar(1), tol )
    @assertEqual( wetrho_surf, rhostar(1), tol )
    @assertEqual( 0.0_r_def, recip_l_mo_sea(1), tol )
    @assertEqual( 0.0_r_def, t1_sd(1), tol )
    @assertEqual( 0.0_r_def, q1_sd(1), tol )

  end subroutine test_bl_surface_none

end module bl_surface_none_kernel_mod_test

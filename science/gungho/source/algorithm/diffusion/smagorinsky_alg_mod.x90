!>@brief Contains code for Smagorinsky diffusion calculation
module smagorinsky_alg_mod

  use constants_mod,            only: i_def, r_def
  use field_mod,                only: field_type
  use field_parent_mod,         only: field_parent_type
  use field_collection_mod,     only: field_collection_type
  use field_collection_iterator_mod, &
                                only: field_collection_iterator_type
  use mr_indices_mod,           only: nummr, imr_v, imr_cl, imr_ci

  use formulation_config_mod,    only: moisture_formulation,    &
                                       moisture_formulation_dry
  use section_choice_config_mod, only: boundary_layer,     &
                                       boundary_layer_um
  use mixing_config_mod,         only: mix_factor, smag_l_calc, &
                                       smag_l_calc_use_geo,     &
                                       vertical_smagorinsky,    &
                                       smag_prandtl

  use tracer_smagorinsky_diff_kernel_mod, only: tracer_smagorinsky_diff_kernel_type
  use momentum_smagorinsky_kernel_mod,    only: momentum_smagorinsky_kernel_type
  use vert_smag_coeff_kernel_mod,         only: vert_smag_coeff_kernel_type
  use vert_smag_scalar_kernel_mod,        only: vert_smag_scalar_kernel_type
  use vert_smag_wind_coeff_kernel_mod,    only: vert_smag_wind_coeff_kernel_type
  use vert_smag_wind_kernel_mod,          only: vert_smag_wind_kernel_type

  use log_mod,                   only: log_event,         &
                                       LOG_LEVEL_INFO,    &
                                       LOG_LEVEL_ERROR
  use mesh_mod,                  only: mesh_type
  use io_config_mod,             only: write_conservation_diag
  use timing_mod,                only: start_timing, stop_timing, tik, LPROF
  use moisture_conservation_alg_mod,   &
                                 only: moisture_conservation_alg
  use sci_geometric_constants_mod,     &
                                 only: get_height_fv, get_panel_id, &
                                       get_delta_at_wtheta, get_dx_at_w2, &
                                       get_dz_at_wtheta, get_da_at_w2
  use sci_fem_constants_mod,     only: get_rmultiplicity_fv
  use fs_continuity_mod,         only: W1, W2, W3, Wtheta

  implicit none

  private

  public :: smagorinsky_alg

  ! Stencil depth for the Smagorinsky diffusion kernels
  integer(kind=i_def), parameter :: smag_stencil_depth = 1

contains

  !> @brief Diffuse prognostic fields using Smagorinsky coefficients
  !> @details The diffusivities either come from the UM boundary-layer scheme,
  !>          or are calculated here: as (mix_factor*delta)**2 * shear, or,
  !>          with vertical_smagorinsky, from the stability-dependent Lilly
  !>          form. Quantities are always diffused in the horizontal; with
  !>          vertical_smagorinsky they are also diffused implicitly in the
  !>          vertical. Tracers are only mixed when their collections are
  !>          passed in.
  !> @param[in,out] dtheta_io      Potential temperature increment to update
  !> @param[in,out] du_io          3D wind increment to update
  !> @param[in,out] mr             mixing ratios
  !> @param[in]     theta          Potential temperature
  !> @param[in]     u              3D wind field
  !> @param[in]     derived_fields Group of derived fields
  !> @param[in]     rho            Density
  !> @param[in]     dt             The model timestep length
  !> @param[in,out] con_tracer_all_outer  Optional conservative tracers
  !>                                      transported every outer iteration
  !> @param[in,out] con_tracer_last_outer Optional conservative tracers
  !>                                      transported in the last outer
  !>                                      iteration
subroutine smagorinsky_alg(dtheta_io, du_io, mr, theta, u, &
                           derived_fields, rho, dt,        &
                           con_tracer_all_outer,           &
                           con_tracer_last_outer )

    implicit none

    ! Prognostic fields
    type( field_type ), intent(inout) :: du_io, dtheta_io
    type( field_type ), intent(inout) :: mr ( nummr )

    type( field_collection_type ), intent(in) :: derived_fields

    type( field_type ), intent(in) :: rho, theta, u
    real( r_def ),      intent(in) :: dt

    type( field_collection_type ), optional, intent(inout) :: con_tracer_all_outer
    type( field_collection_type ), optional, intent(inout) :: con_tracer_last_outer

    ! Increments on state fields
    type( field_type ) :: du, dtheta

    type( field_type ), pointer :: shear => null()
    type( field_type ), pointer :: visc_h
    type( field_type ), pointer :: visc_m
    type( field_type ), pointer :: height_w2 => null()
    type( field_type ), pointer :: height_w1 => null()
    type( field_type ), pointer :: height_wth => null()
    type( field_type ), pointer :: delta => null()
    type( field_type ), pointer :: dz_wth => null()
    type( field_type ), pointer :: dx_at_w2 => null()
    type( field_type ), pointer :: panel_id => null()
    type( field_type ) :: dmr_v, dmr_cl

    ! Fields used only for vertical mixing
    type( field_type ), pointer :: n_squared => null()
    type( field_type ), pointer :: exner_in_wth => null()
    type( field_type ), pointer :: wetrho_in_wth => null()
    type( field_type ), pointer :: wetrho_in_w3 => null()
    type( field_type ), pointer :: height_w3 => null()
    type( field_type ), pointer :: dA => null()
    type( field_type ), pointer :: w2_rmultiplicity => null()
    type( field_type ) :: lambda_sq, m_t
    type( field_type ) :: dtheta_vert, dmr_v_vert, dmr_cl_vert, dmr_ci_vert
    type( field_type ) :: u_phys, du_vert, rhokm_w2, mass_w2

    type( mesh_type ), pointer :: mesh => null()

    logical :: use_moisture
    real( r_def ) :: one_third
    integer(i_def) :: i_mr
    integer(tik)  :: id

    if ( LPROF ) call start_timing( id, 'smagorinsky' )

    call log_event( 'Applying Smagorinsky mixing', LOG_LEVEL_INFO )

    use_moisture = ( moisture_formulation /= moisture_formulation_dry )

    if ( vertical_smagorinsky ) then
      if ( boundary_layer == boundary_layer_um ) call log_event(               &
        'vertical_smagorinsky cannot be used with the UM boundary layer, ' //  &
        'which does its own vertical mixing', LOG_LEVEL_ERROR )
      if ( smag_prandtl <= 0.0_r_def ) call log_event(                         &
        'smag_prandtl must be positive for vertical_smagorinsky',              &
        LOG_LEVEL_ERROR )
    end if

    mesh => theta%get_mesh()

    call du%initialise( u%get_function_space() )
    call invoke(setval_c(du,0.0_r_def))
    call dtheta%initialise( theta%get_function_space() )
    call derived_fields%get_field('visc_h', visc_h)
    call derived_fields%get_field('visc_m', visc_m)

    height_w1  => get_height_fv(W1, mesh%get_id())
    height_w2  => get_height_fv(W2, mesh%get_id())
    height_wth => get_height_fv(Wtheta, mesh%get_id())

    dx_at_w2 => get_dx_at_w2(mesh%get_id())
    panel_id => get_panel_id(mesh%get_id())

    !--------------------------------------------------------------------------
    ! 1. Eddy diffusivities visc_h and visc_m
    !--------------------------------------------------------------------------
    if ( boundary_layer == boundary_layer_um ) then

      ! Use stability-dependent diffusion coefficient from UM BL scheme
      ! This will be the blended BL-Smag coefficient if mixing_option='blending'
      ! Vertical mixing is done by the BL scheme
      call log_event( 'Using stability-dependent Smagorinsky coefficient', LOG_LEVEL_INFO )

    else if ( vertical_smagorinsky ) then

      ! Lilly (1962) coefficient with a moist parcel-test N**2, used for both
      ! the horizontal and the vertical mixing
      call log_event( 'Using Lilly stability-dependent Smagorinsky coefficient', &
                      LOG_LEVEL_INFO )
      call derived_fields%get_field('shear', shear)
      call derived_fields%get_field('smag_n_squared', n_squared)
      call derived_fields%get_field('exner_in_wth', exner_in_wth)
      delta => get_delta_at_wtheta(mesh%get_id())

      ! Squared mixing length (mix_factor*delta)**2, built in its own field so
      ! that the stored delta is left unchanged
      call theta%copy_field_properties(lambda_sq)
      call invoke( setval_X(lambda_sq, delta) )
      if (smag_l_calc == smag_l_calc_use_geo) then
        dz_wth => get_dz_at_wtheta(mesh%get_id())
        one_third = 1.0_r_def / 3.0_r_def
        call invoke( inc_X_powint_n( lambda_sq, 2 ),                          &
                     inc_X_times_Y( lambda_sq, dz_wth ),                      &
                     inc_X_powreal_a( lambda_sq, one_third ) )
      end if
      call invoke( inc_a_times_X( mix_factor, lambda_sq ),                    &
                   inc_X_powint_n( lambda_sq, 2 ) )

      ! Total water of all species, for condensate loading in the parcel test
      call theta%copy_field_properties(m_t)
      call invoke( setval_c(m_t, 0.0_r_def) )
      if ( use_moisture ) then
        do i_mr = 1, nummr
          call invoke( inc_X_plus_Y(m_t, mr(i_mr)) )
        end do
      end if

      call invoke( vert_smag_coeff_kernel_type( visc_m, visc_h, n_squared,    &
                                                theta, mr(imr_v), mr(imr_cl), &
                                                m_t, exner_in_wth, shear,     &
                                                lambda_sq, height_wth ) )

    else ! Without UM BL scheme

      call log_event( 'Using pure Smagorinsky coefficient', LOG_LEVEL_INFO )
      ! Calculate visc_h and visc_m as (mix_factor * delta)**2 * shear
      call derived_fields%get_field('shear', shear)
      ! delta is calculated in sci_calc_delta_at_wtheta_kernel_mod.F90
      ! in lfric core as the mininum of the cell horizontal edge lengths
      delta => get_delta_at_wtheta(mesh%get_id())

      if (smag_l_calc == smag_l_calc_use_geo) then
        ! Use geometric mean mixing length
        dz_wth => get_dz_at_wtheta(mesh%get_id())

        one_third = 1.0_r_def / 3.0_r_def
        call invoke( inc_X_powint_n( delta, 2 ),                              &
                     inc_X_times_Y( delta, dz_wth ),                          &
                     inc_X_powreal_a( delta, one_third ) )
      end if

      call invoke( a_times_X( visc_h, mix_factor, delta ),                    &
                   inc_X_powint_n( visc_h, 2 ),                               &
                   inc_X_times_Y( visc_h, shear ),                            &
                   a_times_X( visc_m, mix_factor, delta ),                    &
                   inc_X_powint_n( visc_m, 2 ),                               &
                   inc_X_times_Y( visc_m, shear ) )

    end if ! Choice of eddy diffusivities

    !--------------------------------------------------------------------------
    ! 2. Horizontal mixing
    !--------------------------------------------------------------------------
    ! Potential temperature:
    call invoke( tracer_smagorinsky_diff_kernel_type( dtheta,               &
                                                      theta,                &
                                                      smag_stencil_depth,   &
                                                      visc_h,               &
                                                      dx_at_w2 ) )

    if ( use_moisture ) then
      ! Water vapour and cloud liquid:
      call dtheta%copy_field_properties(dmr_v)
      call dtheta%copy_field_properties(dmr_cl)
      call invoke( tracer_smagorinsky_diff_kernel_type( dmr_v,              &
                                                        mr(imr_v),          &
                                                        smag_stencil_depth, &
                                                        visc_h,             &
                                                        dx_at_w2 ),         &
                   tracer_smagorinsky_diff_kernel_type( dmr_cl,             &
                                                        mr(imr_cl),         &
                                                        smag_stencil_depth, &
                                                        visc_h,             &
                                                        dx_at_w2 ) )
    end if

    ! Momentum:
    call invoke(momentum_smagorinsky_kernel_type( du,                    &
                                                   u,                    &
                                                   smag_stencil_depth,   &
                                                   dx_at_w2,             &
                                                   smag_stencil_depth,   &
                                                   height_w2,            &
                                                   height_w1,            &
                                                   visc_m,               &
                                                   smag_stencil_depth,   &
                                                   panel_id,             &
                                                   smag_stencil_depth) )

    !--------------------------------------------------------------------------
    ! 3. Implicit vertical mixing, from the same starting state as above.
    !    Each kernel returns the increment over the whole step.
    !--------------------------------------------------------------------------
    if ( vertical_smagorinsky ) then

      ! Potential temperature
      call theta%copy_field_properties(dtheta_vert)
      call invoke( vert_smag_scalar_kernel_type( dtheta_vert, theta, visc_h, &
                                                 rho, height_wth, dt ),      &
                   inc_X_plus_Y( dtheta_io, dtheta_vert ) )

      ! Vapour and cloud condensate (rain, snow and graupel are not mixed)
      if ( use_moisture ) then
        call theta%copy_field_properties(dmr_v_vert)
        call theta%copy_field_properties(dmr_cl_vert)
        call theta%copy_field_properties(dmr_ci_vert)
        call invoke( vert_smag_scalar_kernel_type( dmr_v_vert, mr(imr_v),    &
                                                   visc_h, rho, height_wth,  &
                                                   dt ),                     &
                     vert_smag_scalar_kernel_type( dmr_cl_vert, mr(imr_cl),  &
                                                   visc_h, rho, height_wth,  &
                                                   dt ),                     &
                     vert_smag_scalar_kernel_type( dmr_ci_vert, mr(imr_ci),  &
                                                   visc_h, rho, height_wth,  &
                                                   dt ) )
      end if

      ! Horizontal wind. The W2 dofs hold wind times face area, so diffuse
      ! the wind itself and scale the increment back.
      call derived_fields%get_field('wetrho_in_wth', wetrho_in_wth)
      call derived_fields%get_field('wetrho_in_w3', wetrho_in_w3)
      height_w3        => get_height_fv(W3, mesh%get_id())
      dA               => get_da_at_w2(mesh%get_id())
      w2_rmultiplicity => get_rmultiplicity_fv(W2, mesh%get_id())

      call u%copy_field_properties(u_phys)
      call u%copy_field_properties(du_vert)
      call u%copy_field_properties(rhokm_w2)
      call u%copy_field_properties(mass_w2)
      call invoke( X_divideby_Y( u_phys, u, dA ),                             &
                   setval_c( rhokm_w2, 0.0_r_def ),                           &
                   setval_c( mass_w2, 0.0_r_def ),                            &
                   vert_smag_wind_coeff_kernel_type( rhokm_w2, mass_w2,       &
                                                     visc_m,                  &
                                                     wetrho_in_wth,           &
                                                     wetrho_in_w3,            &
                                                     height_wth, height_w3,   &
                                                     w2_rmultiplicity ),      &
                   vert_smag_wind_kernel_type( du_vert, u_phys, rhokm_w2,     &
                                               mass_w2, dt ),                 &
                   inc_X_times_Y( du_vert, dA ),                              &
                   inc_X_plus_Y( du_io, du_vert ) )

    end if ! vertical_smagorinsky

    !--------------------------------------------------------------------------
    ! 4. Conservative tracers, mixed in the same way as vapour
    !--------------------------------------------------------------------------
    if ( present(con_tracer_all_outer) )                                    &
      call smagorinsky_mix_tracers( con_tracer_all_outer, visc_h, dx_at_w2, &
                                    rho, height_wth, dt )
    if ( present(con_tracer_last_outer) )                                   &
      call smagorinsky_mix_tracers( con_tracer_last_outer, visc_h, dx_at_w2,&
                                    rho, height_wth, dt )

    !--------------------------------------------------------------------------
    ! 5. Apply the increments
    !--------------------------------------------------------------------------
    if (use_moisture) then
      call invoke( inc_X_plus_bY( mr(imr_v), dt, dmr_v ),    &
                   inc_X_plus_bY( mr(imr_cl), dt, dmr_cl ) )
      if ( vertical_smagorinsky ) then
        call invoke( inc_X_plus_Y( mr(imr_v),  dmr_v_vert ),  &
                     inc_X_plus_Y( mr(imr_cl), dmr_cl_vert ), &
                     inc_X_plus_Y( mr(imr_ci), dmr_ci_vert ) )
      end if
    end if

    ! Apply increments from Smagorinsky mixing
    call invoke( inc_X_plus_bY( dtheta_io, dt, dtheta ),      &
                 inc_X_plus_bY( du_io,     dt, du ) )

    if (write_conservation_diag .and. use_moisture) &
      call moisture_conservation_alg( rho, mr, 'After mixing' )

    nullify( height_w1, height_w2 )

    if ( LPROF ) call stop_timing( id, 'smagorinsky' )

  end subroutine smagorinsky_alg

  !> @brief Mix every Wtheta tracer in a collection with the Smagorinsky
  !>        diffusivity: horizontally always, and vertically if
  !>        vertical_smagorinsky is on. Fields on other spaces are skipped.
  !> @param[in,out] tracers    Collection of tracers to mix
  !> @param[in]     visc_h     Scalar eddy diffusivity on theta levels
  !> @param[in]     dx_at_w2   Horizontal grid spacing at W2 dofs
  !> @param[in]     rho        Dry density
  !> @param[in]     height_wth Height of theta levels above the surface
  !> @param[in]     dt         The model timestep length
  subroutine smagorinsky_mix_tracers( tracers, visc_h, dx_at_w2, rho, &
                                      height_wth, dt )

    implicit none

    type( field_collection_type ), target, intent(inout) :: tracers
    type( field_type ),            intent(in)    :: visc_h, dx_at_w2, rho
    type( field_type ),            intent(in)    :: height_wth
    real( r_def ),                 intent(in)    :: dt

    type( field_collection_iterator_type ) :: iterator
    class( field_parent_type ), pointer    :: field_ptr => null()
    type( field_type ),         pointer    :: tracer => null()
    type( field_type )                     :: dtracer_h, dtracer_v

    call iterator%initialise(tracers)
    do
      if ( .not. iterator%has_next() ) exit
      field_ptr => iterator%next()

      tracer => null()
      select type(field_ptr)
        type is (field_type)
          if ( field_ptr%which_function_space() == Wtheta ) tracer => field_ptr
      end select
      if ( .not. associated(tracer) ) cycle

      ! Both increments are computed from the tracer before it is updated
      call tracer%copy_field_properties(dtracer_h)
      call invoke( tracer_smagorinsky_diff_kernel_type( dtracer_h,          &
                                                        tracer,             &
                                                        smag_stencil_depth, &
                                                        visc_h,             &
                                                        dx_at_w2 ) )
      if ( vertical_smagorinsky ) then
        call tracer%copy_field_properties(dtracer_v)
        call invoke( vert_smag_scalar_kernel_type( dtracer_v, tracer,       &
                                                   visc_h, rho,             &
                                                   height_wth, dt ),        &
                     inc_X_plus_Y( tracer, dtracer_v ) )
      end if
      call invoke( inc_X_plus_bY( tracer, dt, dtracer_h ) )
    end do

  end subroutine smagorinsky_mix_tracers

end module smagorinsky_alg_mod

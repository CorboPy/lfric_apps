!-----------------------------------------------------------------------------
!> Test the idealised radiation forcing kernel
module idealised_radiation_kernel_mod_test

  use constants_mod, only : i_def, r_def
  use funit

  implicit none

  private
  public :: set_up, tear_down, test_flux_forcing, test_fixed_forcing, &
            test_subcycled_cooling

  integer(kind=i_def), parameter :: nlayers = 3_i_def
  integer(kind=i_def), parameter :: ndf_wth = 2_i_def
  integer(kind=i_def), parameter :: undf_wth = nlayers + 1_i_def
  real(kind=r_def),    parameter :: dt = 600.0_r_def

  real(kind=r_def), parameter :: column_cooling_flux = 200.0_r_def
  real(kind=r_def), parameter :: tropopause_temperature = 200.0_r_def
  real(kind=r_def), parameter :: nudging_timescale = 21600.0_r_def
  real(kind=r_def), parameter :: tol = 1.0e-12_r_def

  integer(kind=i_def) :: map_wth(ndf_wth)
  real(kind=r_def)    :: theta(undf_wth)
  real(kind=r_def)    :: exner_in_wth(undf_wth)
  real(kind=r_def)    :: temperature_mean(undf_wth)
  real(kind=r_def)    :: mr_v_n(undf_wth), mr_cl_n(undf_wth), mr_r_n(undf_wth)
  real(kind=r_def)    :: wetrho_in_wth(undf_wth), dz_wtheta(undf_wth)
  real(kind=r_def)    :: cpv, cl

contains

  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  @before
  subroutine set_up()

    use feign_config_mod, only : feign_planet_config
    use driver_water_constants_mod, only : heat_capacity_h2o_vapour, &
                                           heat_capacity_h2o

    implicit none

    call feign_planet_config( gravity=9.80665_r_def,   &
                              omega=7.292116e-5_r_def, &
                              rd=287.05_r_def,         &
                              cp=1005.0_r_def,         &
                              p_zero=100000.0_r_def,   &
                              scaling_factor=1.0_r_def )

    map_wth = (/ 1_i_def, 2_i_def /)
    theta = (/ 300.0_r_def, 300.0_r_def, 275.0_r_def, 300.0_r_def /)
    exner_in_wth = (/ 1.0_r_def, 0.9_r_def, 0.8_r_def, 0.7_r_def /)
    temperature_mean = (/ 280.0_r_def, 240.0_r_def, 200.0_r_def, 190.0_r_def /)
    mr_v_n = (/ 0.010_r_def, 0.008_r_def, 0.005_r_def, 0.002_r_def /)
    mr_cl_n = 0.0_r_def
    mr_r_n = 0.0_r_def
    wetrho_in_wth = (/ 1.2_r_def, 1.1_r_def, 1.0_r_def, 0.9_r_def /)
    dz_wtheta = (/ 50.0_r_def, 100.0_r_def, 100.0_r_def, 100.0_r_def /)
    cpv = heat_capacity_h2o_vapour
    cl = heat_capacity_h2o

  end subroutine set_up

  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  @after
  subroutine tear_down()

    use configuration_mod, only: final_configuration

    implicit none

    call final_configuration()

  end subroutine tear_down

  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  !> Compute the tropospheric-cooling / stratospheric-nudging increment
  !> profile only, i.e. without the surface-layer adjustment, against which
  !> the kernel output is compared by the tests below. The tropospheric
  !> cooling is applied over cooling_dt and its rate returned in rate.
  subroutine background_dtheta(cooling_dt, cpm, answer, rate)

    use planet_config_mod, only : cp, gravity, p_zero, kappa

    implicit none

    real(kind=r_def), intent(in)  :: cooling_dt
    real(kind=r_def), intent(out) :: cpm(0:nlayers)
    real(kind=r_def), intent(out) :: answer(undf_wth)
    real(kind=r_def), intent(out) :: rate(undf_wth)

    real(kind=r_def)    :: dtemp_dt_troposphere(0:nlayers)
    real(kind=r_def)    :: p_surface, p_tropopause, delta_pressure
    integer(kind=i_def) :: k

    do k = 0, nlayers
      cpm(k) = cp + mr_v_n(map_wth(1) + k) * cpv &
          + (mr_cl_n(map_wth(1) + k) + mr_r_n(map_wth(1) + k)) * cl
    end do

    p_surface = p_zero * exner_in_wth(map_wth(1)) ** (1.0_r_def / kappa)
    p_tropopause = p_zero * exner_in_wth(map_wth(1) + 2_i_def) **                  &
                  (1.0_r_def / kappa)
    delta_pressure = p_surface - p_tropopause

    do k = 0, nlayers
      dtemp_dt_troposphere(k) = -column_cooling_flux * gravity / (cpm(k) * delta_pressure)
    end do

    do k = 0, 2
      rate(map_wth(1) + k) = dtemp_dt_troposphere(k)
      answer(map_wth(1) + k) = dtemp_dt_troposphere(k) * cooling_dt /              &
                               exner_in_wth(map_wth(1) + k)
    end do
    rate(map_wth(1) + 3_i_def) = 0.0_r_def
    answer(map_wth(1) + 3_i_def) =                                                  &
      (-(theta(map_wth(1) + 3_i_def) * exner_in_wth(map_wth(1) + 3_i_def) -       &
         tropopause_temperature) / nudging_timescale) * dt /                       &
      exner_in_wth(map_wth(1) + 3_i_def)

  end subroutine background_dtheta

  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  !> Assert that a kernel output column matches the expected column.
  subroutine assert_column(expected, actual)

    use, intrinsic :: iso_fortran_env, only : real64

    implicit none

    real(kind=r_def), intent(in) :: expected(undf_wth), actual(undf_wth)

    real(kind=r_def)    :: use_tol
    integer(kind=i_def) :: k

    do k = 0, nlayers
      if (r_def == real64) then
        use_tol = tol
      else
        use_tol = 10.0_r_def * spacing(expected(map_wth(1) + k))
      end if
      @assertEqual( expected(map_wth(1) + k), actual(map_wth(1) + k), use_tol )
    end do

  end subroutine assert_column

  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  !> With the 'flux' surface treatment, the surface layer increment adds a
  !> prescribed sensible heat flux term on top of the tropospheric cooling.
  @test
  subroutine test_flux_forcing()

    use idealised_radiation_kernel_mod, only : idealised_radiation_code
    use feign_config_mod, only : feign_external_forcing_config
    use external_forcing_config_mod, only : sensible_heat_flux, &
                                            theta_surface_forcing_flux

    implicit none

    real(kind=r_def) :: dtheta(undf_wth), dtemp_dt_trop(undf_wth)
    real(kind=r_def) :: answer(undf_wth), rate(undf_wth)
    real(kind=r_def) :: cpm(0:nlayers)

    call feign_external_forcing_config(                                    &
        column_cooling_flux=column_cooling_flux,                           &
        tropopause_temperature=tropopause_temperature,                     &
        nudging_timescale=nudging_timescale,                               &
        theta_surface_forcing=theta_surface_forcing_flux,                  &
        sensible_heat_flux=1000.0_r_def )

    dtheta = 0.0_r_def
    call idealised_radiation_code( nlayers, dtheta, dtemp_dt_trop,               &
                                   theta, exner_in_wth,                           &
                                   temperature_mean,                              &
                                   mr_v_n, mr_cl_n, mr_r_n,                       &
                                   wetrho_in_wth, dz_wtheta,                      &
                                   cpv, cl, dt, dt, ndf_wth, undf_wth, map_wth )

    call background_dtheta(dt, cpm, answer, rate)

    answer(map_wth(1)) = answer(map_wth(1)) + (sensible_heat_flux * dt) /          &
        (wetrho_in_wth(map_wth(1)) * cpm(0) * dz_wtheta(map_wth(1)) *              &
         exner_in_wth(map_wth(1)))

    call assert_column(answer, dtheta)
    call assert_column(rate, dtemp_dt_trop)

  end subroutine test_flux_forcing

  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  !> With the 'fixed' surface treatment, the surface layer increment is
  !> overwritten so that the resulting absolute temperature equals the
  !> prescribed target exactly, regardless of the tropospheric cooling term.
  @test
  subroutine test_fixed_forcing()

    use idealised_radiation_kernel_mod, only : idealised_radiation_code
    use feign_config_mod, only : feign_external_forcing_config
    use external_forcing_config_mod, only : theta_surface_forcing_fixed

    implicit none

    real(kind=r_def), parameter :: target_temperature = 290.0_r_def

    real(kind=r_def) :: dtheta(undf_wth), dtemp_dt_trop(undf_wth)
    real(kind=r_def) :: answer(undf_wth), rate(undf_wth)
    real(kind=r_def) :: cpm(0:nlayers)

    call feign_external_forcing_config(                                    &
        column_cooling_flux=column_cooling_flux,                           &
        tropopause_temperature=tropopause_temperature,                     &
        nudging_timescale=nudging_timescale,                               &
        theta_surface_forcing=theta_surface_forcing_fixed,                 &
        fixed_surface_temperature=target_temperature )

    dtheta = 0.0_r_def
    call idealised_radiation_code( nlayers, dtheta, dtemp_dt_trop,               &
                                   theta, exner_in_wth,                           &
                                   temperature_mean,                              &
                                   mr_v_n, mr_cl_n, mr_r_n,                       &
                                   wetrho_in_wth, dz_wtheta,                      &
                                   cpv, cl, dt, dt, ndf_wth, undf_wth, map_wth )

    call background_dtheta(dt, cpm, answer, rate)

    answer(map_wth(1)) = target_temperature / exner_in_wth(map_wth(1)) - theta(map_wth(1))
    ! The surface cooling is discarded by the fixed treatment
    rate(map_wth(1)) = 0.0_r_def

    call assert_column(answer, dtheta)
    call assert_column(rate, dtemp_dt_trop)

  end subroutine test_fixed_forcing

  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  !> The tropospheric cooling increment scales with cooling_dt, while the
  !> nudging and surface flux terms still use dt. The reported cooling rate
  !> is independent of cooling_dt.
  @test
  subroutine test_subcycled_cooling()

    use idealised_radiation_kernel_mod, only : idealised_radiation_code
    use feign_config_mod, only : feign_external_forcing_config
    use external_forcing_config_mod, only : sensible_heat_flux, &
                                            theta_surface_forcing_flux

    implicit none

    real(kind=r_def), parameter :: cooling_dts(2) = (/ 0.0_r_def, 5.0_r_def * dt /)

    real(kind=r_def) :: dtheta(undf_wth), dtemp_dt_trop(undf_wth)
    real(kind=r_def) :: answer(undf_wth), rate(undf_wth)
    real(kind=r_def) :: cpm(0:nlayers)
    integer(kind=i_def) :: i

    call feign_external_forcing_config(                                    &
        column_cooling_flux=column_cooling_flux,                           &
        tropopause_temperature=tropopause_temperature,                     &
        nudging_timescale=nudging_timescale,                               &
        theta_surface_forcing=theta_surface_forcing_flux,                  &
        sensible_heat_flux=1000.0_r_def )

    do i = 1, size(cooling_dts)
      dtheta = 0.0_r_def
      call idealised_radiation_code( nlayers, dtheta, dtemp_dt_trop,             &
                                     theta, exner_in_wth,                         &
                                     temperature_mean,                            &
                                     mr_v_n, mr_cl_n, mr_r_n,                     &
                                     wetrho_in_wth, dz_wtheta,                    &
                                     cpv, cl, dt, cooling_dts(i),                 &
                                     ndf_wth, undf_wth, map_wth )

      call background_dtheta(cooling_dts(i), cpm, answer, rate)

      answer(map_wth(1)) = answer(map_wth(1)) + (sensible_heat_flux * dt) /        &
          (wetrho_in_wth(map_wth(1)) * cpm(0) * dz_wtheta(map_wth(1)) *            &
           exner_in_wth(map_wth(1)))

      call assert_column(answer, dtheta)
      call assert_column(rate, dtemp_dt_trop)
    end do

  end subroutine test_subcycled_cooling

end module idealised_radiation_kernel_mod_test
